var water2018 = getS1Water(2017);
var water2024 = getS1Water(2024);

var w18 = water2018.unmask(0);
var w24 = water2024.unmask(0);

// Transition encoding
//  0 = non-water both years
//  1 = water loss (2018 → land 2024)
//  2 = water gain (land 2018 → water 2024)
//  3 = persistent water

var transition = w24.multiply(2).add(w18);
// Mask land so it stays transparent
var exportImage = transition.selfMask();
var vis = {
  min: 1,
  max: 3,
  palette: [
    'ff0000', // water loss
    '00ff00', // water gain
    '0000ff'  // persistent water
  ]
};
var transitionClean = transition
  .focal_mode({radius: 1, units: 'pixels'})
  .selfMask();

Map.addLayer(
  transitionClean,
  {
    min: 1,
    max: 3,
    palette: ['ff0000', '00ff00', '0000ff']
  },
  'Water movement 2018–2024 (cleaned)'
);

