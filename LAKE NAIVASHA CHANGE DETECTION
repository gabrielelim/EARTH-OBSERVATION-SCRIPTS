//sentinel sar collection

function getS1Water(year){
  var start = ee.Date.fromYMD(year,10,1);
  var end = ee.Date.fromYMD(year,10,31);
  
  
  var s1 = ee.ImageCollection('COPERNICUS/S1_GRD')
   .filterBounds(aoi)
   .filterDate(start,end)
   .filter(ee.Filter.eq('instrumentMode','IW'))
   .filter(ee.Filter.listContains('transmitterReceiverPolarisation','VV'))
   .select('VV');
  var median = s1.median().clip(aoi);
  var water= s1.median().lt(-20).rename('water').selfMask();
  return water;
  
}

var s1 = ee.ImageCollection('COPERNICUS/S1_GRD')
   .filterBounds(aoi)
   .filterDate('2019-01-01','2020-12-31')
   .filter(ee.Filter.eq('instrumentMode','IW'))
   .filter(ee.Filter.listContains('transmitterReceiverPolarisation','VV'))
   .filter(ee.Filter.eq('orbitProperties_pass','DESCENDING'))
   .select('VV');

var s2 = ee.ImageCollection('COPERNICUS/S1_GRD')
   .filterBounds(aoi)
   .filterDate('2024-01-01','2024-12-31')
   .filter(ee.Filter.eq('instrumentMode','IW'))
   .filter(ee.Filter.listContains('transmitterReceiverPolarisation','VV'))
   .filter(ee.Filter.eq('orbitProperties_pass','ASCENDING'))
   .select('VV');
      

var s1_median =s2.median().clip(aoi);
var s2_median= s2.median().clip(aoi);

